{
  "swagger": "2.0",
  "info": {
    "title": "SwanLab API",
    "description": "Open API documentation for SwanLab, covering the OAuth2 authorization and usage API as well as the self-hosted management API.\n\n<a href=\"./zh-cn.json\" download>download Chinese document (zh-cn.json)</a> · <a href=\"./en.json\" download>download English document (en.json)</a>",
    "version": "1.0.0"
  },
  "host": "api.swanlab.cn",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "basicAuth": {
      "type": "basic",
      "description": "Authorization: Basic <app_id:app_secret(base64-encoded)>"
    },
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Authorization: Bearer <access_token>"
    },
    "apiKeyAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Authorization: ApiKey <instance root user's API Key>"
    }
  },
  "tags": [
    {
      "name": "OAuth2",
      "description": "OAuth2 authorization and usage API.\n`POST /auth/oauth2/token` uses `Basic` authentication, with the request header `Authorization: Basic base64(app_id:app_secret)`;\n`GET /auth/oauth2/user/info` and `GET /auth/oauth2/user/api_key` use a `Bearer` token, with the request header `Authorization: Bearer <access_token>`."
    },
    {
      "name": "Self-hosted",
      "description": "Self-hosted management API. Except for `POST /self_hosted/root`, calling these endpoints requires the instance root user's API Key, with the request header `Authorization: ApiKey <api_key>`."
    }
  ],
  "paths": {
    "/self_hosted/root": {
      "post": {
        "operationId": "self-hosted-root",
        "summary": "Create root user",
        "description": "1. Only one root user can exist; creating another returns `409 Conflict`;\n2. The License is verified online; `cloud_url` is configurable and defaults to `https://api.swanlab.cn/api`\n\t1. an expired license returns `403 Forbidden`;\n\t2. a missing license returns `404 Not Found`;\n\t3. otherwise it returns `502 Bad Gateway`;\n3. A successful creation returns `201`;\n4. The root user is marked by `group.comment` set to `root`;\n5. After online verification a License record is created locally for later validation.\n6. A commercial license must be verified online; offline use returns `403`",
        "security": [],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Request body",
            "schema": {
              "type": "object",
              "required": [
                "username",
                "password",
                "license"
              ],
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Root user created successfully; returns the user information",
            "schema": {
              "type": "object",
              "required": [
                "username",
                "name",
                "avatar",
                "createdAt",
                "verified",
                "tag"
              ],
              "properties": {
                "username": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "avatar": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                },
                "verified": {
                  "type": "boolean"
                },
                "tag": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "license error: License_Expired: expired; License_Verification_Failed: invalid token; License_Activation_Expired: past the activation deadline; License_User_Count_Exceeded: the existing user count exceeds the plan limit; License_Activation_Failed: online activation failed",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "A root user already exists; repeated activation",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/users": {
      "post": {
        "operationId": "self-hosted-create-users",
        "summary": "Bulk add users",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Request body",
            "schema": {
              "type": "object",
              "required": [
                "users"
              ],
              "properties": {
                "users": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "username",
                      "password"
                    ],
                    "properties": {
                      "username": {
                        "type": "string",
                        "description": "Username, required"
                      },
                      "password": {
                        "type": "string",
                        "description": "Password"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created, added successfully"
          },
          "403": {
            "description": "Forbidden, no permission to add users; Max_Limit the organization member limit has been reached, and all users added this time are cancelled",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/user/password": {
      "post": {
        "operationId": "self-hosted-change-password",
        "summary": "Root user changes password",
        "description": "1. The root user can change the password of any user.\n2. A non-root user can only change their own password.",
