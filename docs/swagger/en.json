    "/self_hosted/user/del": {
      "post": {
        "operationId": "self-hosted-delete-user",
        "summary": "Admin deletes a member",
        "description": "1. Only the root user can delete members\n2. The root user cannot delete itself, otherwise `409 Conflict`\n3. Deletion is a soft delete: `status` on the `user` table and on the `group` table (`type=PERSON`) is set to `DISABLED`\n4. All sessions of the user in the session table are hard-deleted\n5. All cached sessions of the user are removed\n6. If the target user is an administrator of a non-personal organization, they must first leave the organization or have their role changed\n7. All related projects, collaborators and applications are deleted\n8. The user's SSO ProviderUser bindings are deleted",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Request body",
            "schema": {
              "type": "object",
              "required": [
                "username"
              ],
              "properties": {
                "username": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content deleted successfully, empty response body"
          },
          "403": {
            "description": "Forbidden no permission to delete",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not_Found the user does not exist",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict the root user cannot be deleted; Conflict the target user is an administrator of an organization (excluding the personal one)",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/team/member": {
      "post": {
        "operationId": "self-hosted-upsert-team-member",
        "summary": "Admin invites & changes member permissions",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Request body",
            "schema": {
              "type": "object",
              "required": [
                "group",
                "username",
                "role"
              ],
              "properties": {
                "group": {
                  "type": "string",
                  "description": "The organization's `username`, required"
                },
                "username": {
                  "type": "string",
                  "description": "Target user, required"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "OWNER",
                    "MEMBER",
                    "VIEWER"
                  ],
                  "description": "Role to assign (required), one of: `OWNER`, `MEMBER`, `VIEWER`"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK, updated successfully"
          },
          "404": {
            "description": "Not Found, the member whose role is being changed does not exist; Not Found, the organization whose role is being changed does not exist",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, no permission to invite members to the organization",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
