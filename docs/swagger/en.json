                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found the target user does not exist",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/user/pause": {
      "post": {
        "operationId": "self-hosted-pause-user",
        "summary": "Admin deactivates a user",
        "description": "Deactivating a user deletes their API Key and session cache, but keeps SSO ProviderUser bindings.",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Request body",
            "schema": {
              "type": "object",
              "required": [
                "username"
              ],
              "properties": {
                "username": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content deactivated successfully, empty response body"
          },
          "403": {
            "description": "Forbidden no permission to deactivate",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not_Found the user does not exist",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict the root user cannot be deactivated",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/user/unpause": {
      "post": {
        "operationId": "self-hosted-unpause-user",
