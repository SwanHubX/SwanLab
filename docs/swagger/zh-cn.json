            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict 无法停用root用户",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
