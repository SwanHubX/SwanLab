    "/auth/oauth2/token": {
      "post": {
        "operationId": "oauth2-token",
        "summary": "获取或刷新 Access Token",
        "description": "根据 authorization code 签发 access token 和 refresh token，或使用 refresh token 刷新 access token。",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "请求体",
            "schema": {
              "type": "object",
              "required": [
                "grant_type"
              ],
              "properties": {
                "grant_type": {
                  "type": "string",
                  "enum": [
                    "authorization_code",
                    "refresh_token"
                  ],
                  "description": "授权类型"
                },
                "code": {
                  "type": "string",
                  "description": "传入回调地址的 authorization code"
                },
                "refresh_token": {
                  "type": "string",
                  "description": "refresh token"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取或刷新 Access Token",
            "schema": {
              "type": "object",
              "required": [
                "access_token",
                "expires_in"
              ],
              "properties": {
                "access_token": {
                  "type": "string",
                  "description": "access token，有效期 2 小时"
                },
                "refresh_token": {
                  "type": "string",
                  "description": "refresh token，有效期 30 天（仅在 grant_type=authorization_code 时返回）"
                },
                "expires_in": {
                  "type": "integer",
                  "format": "int32",
                  "description": "access token 有效期（秒），固定为 7200"
                }
              }
            }
          },
          "400": {
            "description": "bad_request：请求体错误或 grant_type 不支持；error_code：code 无效、已过期或已被消费；error_token：refresh_token 无效或已过期",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized：Basic Auth 缺失、app_secret 错误，或 code / refresh token 不属于当前应用",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "not_found：app_id 不存在",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "parse_error：JSON 解析失败；random_error：生成 token 失败；database_error：Redis 操作失败",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "OAuth2"
        ]
      }
    },
