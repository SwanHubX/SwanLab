          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
