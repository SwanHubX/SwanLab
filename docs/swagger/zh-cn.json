    "/self_hosted/user/del": {
      "post": {
        "operationId": "self-hosted-delete-user",
        "summary": "超管删除成员",
        "description": "1. 只有根用户可以删除成员\n2. 根用户无法删除自己，否则 `409 Conflict`\n3. 删除操作为软删除, `user`表`status`和`group`表`type=PERSON`的`status`会变更为 `DISABLED`\n4. 会硬删除session表中所有关于该用户的会话信息\n5. 删除缓存中所有该用户的会话信息\n6. 若目标用户是某个非个人组织的管理员，则需要先进行退出组织/修改角色等操作\n7. 删除所有关联的项目、协作者、申请信息\n8. 删除该用户关联的 SSO ProviderUser 绑定记录",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "请求体",
            "schema": {
              "type": "object",
              "required": [
                "username"
              ],
              "properties": {
                "username": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content，删除成功（软删除），返回空响应体"
          },
          "403": {
            "description": "Forbidden 无权限删除",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not_Found 用户不存在",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict 无法删除root用户；Conflict 目标用户是某个组织的管理员（排除个人组织）",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/team/member": {
      "post": {
        "operationId": "self-hosted-upsert-team-member",
        "summary": "超管邀请&修改成员权限",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "请求体",
            "schema": {
              "type": "object",
              "required": [
                "group",
                "username",
                "role"
              ],
              "properties": {
                "group": {
                  "type": "string",
                  "description": "组织空间`username`，必选"
                },
                "username": {
                  "type": "string",
                  "description": "指定用户, 必选"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "OWNER",
                    "MEMBER",
                    "VIEWER"
                  ],
                  "description": "指定角色, 必选, `OWNER`, `MEMBER`, `VIEWER`"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK，修改成功"
          },
          "404": {
            "description": "Not Found：组织不存在；用户不存在",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden，对组织无权限邀请成员",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
