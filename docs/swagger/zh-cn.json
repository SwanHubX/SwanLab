            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
