{
  "swagger": "2.0",
  "info": {
    "title": "SwanLab API",
    "description": "SwanLab 开放 API 文档，包含 OAuth2 授权与使用接口，以及私有化 root 管理接口。\n\n<a href=\"./zh-cn.json\" download>下载中文文档 (zh-cn.json)</a> · <a href=\"./en.json\" download>download English document (en.json)</a>",
    "version": "1.0.0"
  },
  "host": "api.swanlab.cn",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "basicAuth": {
      "type": "basic",
      "description": "Authorization: Basic <app_id:app_secret(base64编码)>"
    },
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Authorization: Bearer <access_token>"
    },
    "apiKeyAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Authorization: ApiKey <实例 root 用户的 API Key>"
    }
  },
  "tags": [
    {
      "name": "OAuth2",
      "description": "OAuth2 授权与使用接口\n`POST /auth/oauth2/token` 使用 `Basic` 认证，请求头格式为 `Authorization: Basic base64(app_id:app_secret)`；\n`GET /auth/oauth2/user/info` 与 `GET /auth/oauth2/user/api_key` 使用 `Bearer` token，请求头格式为 `Authorization: Bearer <access_token>`。"
    },
    {
      "name": "Self-hosted",
      "description": "私有化部署（Self-hosted）管理接口\n除 `POST /self_hosted/root` 外，调用这些接口需要携带实例 root 用户的 API Key，请求头格式为 `Authorization: ApiKey <api_key>`。"
    }
  ],
  "paths": {
    "/self_hosted/root": {
      "post": {
        "operationId": "self-hosted-root",
        "summary": "创建根用户",
        "description": "1. 根用户只能存在一个，重复创建会响应 `409 Conflict`;\n2. License 通过云端验证，`cloud_url` 可配置，默认为 `https://api.swanlab.cn/api`\n\t1. license 过期响应 `403 Forbidden`;\n\t2. license 不存在响应 `404 Not Found`;\n\t3. 其他情况下响应 `502 Bad Gateway`;\n3. 创建成功响应 `201`;\n4. 根用户通过 `group.comment` 标识为 `root`;\n5. License 通过云端验证后会在本地创建 License 对象，用于后续验证。\n6. 商业版 license 必须在线验证，离线将以 `403` 返回",
        "security": [],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "请求体",
            "schema": {
              "type": "object",
              "required": [
                "username",
                "password",
                "license"
              ],
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "创建根用户成功，返回用户信息",
            "schema": {
              "type": "object",
              "required": [
                "username",
                "name",
                "avatar",
                "createdAt",
                "verified",
                "tag"
              ],
              "properties": {
                "username": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "avatar": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                },
                "verified": {
                  "type": "boolean"
                },
                "tag": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "license 错误：License_Expired: 过期；License_Verification_Failed: token 错误；License_Activation_Expired: 超过激活截止时间；License_User_Count_Exceeded: 系统已有用户超过套餐最大用户数；License_Activation_Failed: 联网激活失败",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "已有根用户，重复激活",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "异常错误",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/users": {
      "post": {
        "operationId": "self-hosted-create-users",
        "summary": "批量添加用户",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "请求体",
            "schema": {
              "type": "object",
              "required": [
                "users"
              ],
              "properties": {
                "users": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "username",
                      "password"
                    ],
                    "properties": {
                      "username": {
                        "type": "string",
                        "description": "用户名，必选"
                      },
                      "password": {
                        "type": "string",
                        "description": "密码"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created，添加成功；已存在的用户及请求内重复的 username 会被跳过"
          },
          "403": {
            "description": "Forbidden，无权增加用户；Max_Limit 组织人数达到限制，此次添加的用户将全部取消",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Self-hosted"
        ]
      }
    },
    "/self_hosted/user/password": {
